# Copy this file to .env and adjust if needed.

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Leave CHROMA_HOST unset for local/dev runs (uses an embedded, on-disk
# Chroma client at CHROMA_PERSIST_DIR). docker-compose.yml sets CHROMA_HOST
# itself so the API/watcher containers talk to the chroma service instead.
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=pdf_grounding

CHUNK_SIZE=250
CHUNK_OVERLAP=50
TOP_K=4

WATCH_FOLDER=./data/pdfs
